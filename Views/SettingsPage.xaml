<UserControl x:Class="StreamLightControl2.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamLightControl2">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,22,24,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <!-- Algemeen -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Algemeen" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                        <CheckBox Style="{StaticResource Switch}" Content="Automatisering starten zodra de app opent" IsChecked="{Binding Settings.General.StartAutomationOnLaunch}" Margin="0,0,0,12"/>
                        <CheckBox Style="{StaticResource Switch}" Content="Stream Mode altijd bovenop andere vensters" IsChecked="{Binding Settings.General.StreamModeTopmost}" Margin="0,0,0,12"/>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SafeMode, Mode=OneWay}" Click="SafeMode_Click">
                            <TextBlock><Run Text="Safe Mode"/><Run Text="  – alle automatiseringen uit, instellingen blijven bewaard" Foreground="{StaticResource Text3Brush}"/></TextBlock>
                        </CheckBox>
                        <TextBlock Text="Thema" Style="{StaticResource FieldLabel}" Margin="0,18,0,0"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ThemeBox" DisplayMemberPath="Name" SelectedValuePath="Key" SelectionChanged="Theme_SelectionChanged"/>
                            <Button x:Name="ThemeRestartButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Tag="&#xE72C;" Content="Herstarten" Margin="8,0,0,0"
                                    Visibility="Collapsed" Click="ThemeRestart_Click" ToolTip="De app opnieuw starten met het nieuwe thema"/>
                        </Grid>
                        <TextBlock x:Name="ThemeHint" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Kerst, herfst of zomer: andere kleuren voor de hele app. ‘Automatisch’ kiest zelf het seizoen."/>
                    </StackPanel>
                </Border>

                <!-- Verlichting -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Verlichting" Style="{StaticResource H2}"/>
                        <TextBlock Text="Hoe lichtshows naar je Govee-lampen worden gestuurd." Style="{StaticResource Caption}" Margin="0,4,0,16"/>

                        <TextBlock Text="Manier van knipperen" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{x:Static local:Options.FlashModeList}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Lighting.FlashMode}" Margin="0,0,0,4"/>
                        <TextBlock Text="Knippert je lamp traag of met een fade? Probeer ‘Kleur naar zwart’." Style="{StaticResource Caption}" Margin="0,0,0,16"/>

                        <Grid>
                            <TextBlock Text="Pauze tussen commando's" Style="{StaticResource FieldLabel}"/>
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource Caption}"><Run Text="{Binding Settings.Lighting.CommandDelayMs, Mode=OneWay}"/><Run Text=" ms"/></TextBlock>
                        </Grid>
                        <Slider Minimum="30" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Settings.Lighting.CommandDelayMs}"/>
                        <TextBlock Text="Lager = snellere effecten. Mist je lamp stappen? Zet hem hoger (standaard 80 ms)." Style="{StaticResource Caption}" Margin="0,4,0,16"/>

                        <Grid>
                            <TextBlock Text="Snelste kleurwissel van je strip" Style="{StaticResource FieldLabel}"/>
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource Caption}"><Run Text="{Binding Settings.Lighting.MinChangeMs, Mode=OneWay}"/><Run Text=" ms"/></TextBlock>
                        </Grid>
                        <Slider Minimum="40" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Settings.Lighting.MinChangeMs}"/>
                        <TextBlock Text="Wissels die sneller komen worden overgeslagen, zodat je strip het bijhoudt. Bepaal de juiste waarde met de Snelheidstest in Device Manager. Standaard 550 ms (±2 wissels per seconde). Springt je strip direct (Device Manager), dan 40 ms = geen limiet."
                                   Style="{StaticResource Caption}" Margin="0,4,0,16"/>

                        <Grid>
                            <TextBlock Text="Licht eerder sturen (vertraging opvangen)" Style="{StaticResource FieldLabel}"/>
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource Caption}"><Run Text="{Binding Settings.Lighting.LatencyMs, Mode=OneWay}"/><Run Text=" ms"/></TextBlock>
                        </Grid>
                        <Slider Minimum="0" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Settings.Lighting.LatencyMs}"/>
                        <TextBlock Text="Komt het licht steeds net ná de beat? Meet het hieronder, of zet dit zelf hoger. Geldt voor lichtshows én Spotify." Style="{StaticResource Caption}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                        <Button x:Name="MeasureButton" Style="{StaticResource SecondaryButton}" Tag="&#xE916;" Content="Vertraging meten" HorizontalAlignment="Left" Click="MeasureLatency_Click"
                                ToolTip="Je strip flitst 12 keer wit. Tik op de spatiebalk precies als je de flits ZIET. De app rekent uit hoeveel eerder het licht moet."/>
                        <Border x:Name="MeasurePanel" Visibility="Collapsed" Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="16,14" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Kijk naar je ledstrip" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12" TextWrapping="Wrap"
                                           Text="Druk op de SPATIEBALK (of klik op Tik) precies op het moment dat je de strip wit ZIET flitsen. Niet op de app letten, alleen op de strip. Probeer in het ritme mee te tikken."/>
                                <Grid>
                                    <Button x:Name="TapButton" Style="{StaticResource PrimaryButton}" Content="Tik" MinWidth="120" HorizontalAlignment="Left" Click="Tap_Click"/>
                                    <TextBlock x:Name="MeasureProgress" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="MeasureResult" Style="{StaticResource Caption}" Margin="0,8,0,16" TextWrapping="Wrap" Text=" "/>

                        <Grid>
                            <TextBlock Text="Helderheid lichtshows" Style="{StaticResource FieldLabel}"/>
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource Caption}"><Run Text="{Binding Settings.Lighting.ShowBrightness, Mode=OneWay}"/><Run Text=" %"/></TextBlock>
                        </Grid>
                        <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Settings.Lighting.ShowBrightness}"/>
                        <TextBlock Text="Geldt voor alle lichtshows, song-shows en de Spotify-modus. Is het licht te fel voor je streamcamera (overbelicht, flikkert)? Zet dit lager. Standaard 60 %."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,16"/>

                        <CheckBox Style="{StaticResource Switch}" Content="Strobes beperken (max. 3 flitsen per seconde)" IsChecked="{Binding Settings.Lighting.LimitStrobes}" Margin="0,0,0,4"/>
                        <TextBlock Text="Snelle witte strobes kunnen bij kijkers die gevoelig zijn voor flitslicht klachten geven. Zet dit aan als je dat wilt voorkomen; de shows blijven verder hetzelfde."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <TextBlock Text="Na een lichtshow" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="RestoreCombo" ItemsSource="{x:Static local:Options.RestoreModeList}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Lighting.RestoreMode}" SelectionChanged="Restore_Changed"/>
                        <Grid x:Name="FixedColorPanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="8" Background="{Binding Settings.Lighting.RestoreColor, Converter={StaticResource HexToBrush}}" Margin="0,18,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Kleur (HEX)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource MonoBox}" Text="{Binding Settings.Lighting.RestoreColor}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Helderheid (%)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Settings.Lighting.RestoreBrightness}"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox Style="{StaticResource Switch}" Content="Elke 30 seconden de status van mijn lampen controleren" IsChecked="{Binding Settings.Lighting.StatusPolling}" Margin="0,18,0,0"
                                  ToolTip="Zo zie je in de zijbalk direct of een lamp niet meer reageert."/>
                    </StackPanel>
                </Border>

                <!-- Wachtrij -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Wachtrij" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                        <CheckBox Style="{StaticResource Switch}" Content="Shows achter elkaar afspelen, in de volgorde waarin ze binnenkomen" IsChecked="{Binding Settings.Queue.InOrder}" Margin="0,0,0,6"
                                  ToolTip="Net als de sounds in BetterTok en DonateWave: de volgende show begint pas als de vorige (en dus de sound) klaar is. Nooit door elkaar."/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,14" TextWrapping="Wrap"
                                   Text="Aan (aanbevolen): niets onderbreekt een lopende show. Uit: koppelingen met hogere prioriteit gaan voor en kunnen een show onderbreken."/>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Maximaal aantal effecten in de wachtrij" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource NumberBox}" HorizontalAlignment="Right" Text="{Binding Settings.Queue.MaxLength}"
                                     ToolTip="Is de wachtrij vol, dan valt het effect met de laagste prioriteit af."/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Pauze tussen twee lichtshows (ms)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                            <TextBox Style="{StaticResource NumberBox}" HorizontalAlignment="Right" Text="{Binding Settings.Queue.GapMs}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <!-- Updates -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Updates" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14">
                            <Run Text="Je gebruikt versie"/> <Run x:Name="CurrentVersionRun" Text=""/><Run Text=". Nieuwe versies komen van GitHub en worden automatisch geïnstalleerd; je instellingen blijven bewaard."/>
                        </TextBlock>
                        <CheckBox Style="{StaticResource Switch}" Content="Automatisch controleren (bij opstarten en elke 6 uur)" IsChecked="{Binding Settings.Updates.AutoCheck}" Margin="0,0,0,10"/>
                        <CheckBox Style="{StaticResource Switch}" Content="Gevonden update bij het opstarten meteen installeren" IsChecked="{Binding Settings.Updates.AutoInstallOnStart}" Margin="0,0,0,14"
                                  ToolTip="Tijdens het streamen wordt nooit automatisch bijgewerkt; dan krijg je alleen een melding."/>
                        <TextBlock Text="Update-adres (GitHub: eigenaar/repository)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource MonoBox}" Text="{Binding Settings.Updates.Repo, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Tag="&#xE72C;" Content="Nu controleren" Margin="0,0,8,0" Click="CheckUpdates_Click"/>
                            <Button x:Name="InstallUpdateButton" Style="{StaticResource PrimaryButton}" Tag="&#xE896;" Content="Bijwerken" Click="InstallUpdate_Click" Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Gegevens -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Gegevens en back-up" Style="{StaticResource H2}"/>
                        <TextBlock Text="Alle instellingen worden automatisch opgeslagen en blijven bewaard na herstarten." Style="{StaticResource Caption}" Margin="0,4,0,16"/>
                        <TextBlock Text="Opslagmap" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DataPath" Style="{StaticResource MonoBox}" IsReadOnly="True" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Style="{StaticResource SecondaryButton}" Tag="&#xE838;" Content="Map openen" Margin="0,0,8,8" Click="OpenFolder_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Tag="&#xEDE1;" Content="Back-up maken" Margin="0,0,8,8" Click="Export_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Tag="&#xE777;" Content="Back-up terugzetten" Margin="0,0,8,8" Click="Import_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Opnieuw beginnen -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Opnieuw beginnen" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Margin="0,0,180,0">
                                <TextBlock Text="Sessie-statistieken op 0 zetten" FontWeight="SemiBold"/>
                                <TextBlock Text="Follows, gifts, coins en shows op het dashboard. Ook de follower-lijst begint opnieuw." Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <Button Style="{StaticResource SecondaryButton}" Content="Resetten" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ResetStats_Click"/>
                        </Grid>
                        <Grid>
                            <StackPanel Margin="0,0,180,0">
                                <TextBlock Text="Fabrieksinstellingen" FontWeight="SemiBold"/>
                                <TextBlock Text="Verwijdert al je lichtshows, koppelingen en apparaten. Er wordt eerst automatisch een back-up gemaakt." Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <Button Style="{StaticResource DangerButton}" Content="Alles resetten" HorizontalAlignment="Right" VerticalAlignment="Center" Click="FactoryReset_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Over -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Over" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                        <TextBlock Style="{StaticResource Muted}"><Run Text="Stream Light Control "/><Run Text="{Binding Version, Mode=OneWay}"/></TextBlock>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   Text="BetterTok Developer API (Local + Cloud) · Govee LAN API (UDP 4001/4002/4003) · alles draait lokaal op deze pc."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

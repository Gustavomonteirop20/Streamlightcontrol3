<UserControl x:Class="StreamLightControl2.Views.SpotifyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,22,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== LINKS: nu aan het spelen ===================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Modus staat uit -->
                <Border x:Name="OffCard" Style="{StaticResource Card}" Margin="0,0,0,20" BorderBrush="{StaticResource AccentBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Je staat in Stream-modus" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="Nu sturen TikTok-events via BetterTok je lampen. Zet Spotify-modus aan om je lampen mee te laten gaan met de muziek. BetterTok gaat dan uit, zodat de twee elkaar niet storen."/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Tag="&#xE8D6;" Content="Spotify-modus aan" Margin="16,0,0,0" Click="EnableSpotify_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Grote kleurvlak = wat de strip nu laat zien -->
                        <Border x:Name="ColorStage" Height="150" CornerRadius="12,12,0,0" Background="#000000">
                            <Grid>
                                <Border x:Name="BeatFlash" Background="White" Opacity="0" CornerRadius="12,12,0,0"/>
                                <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,18">
                                    <Border x:Name="StatePill" Style="{StaticResource Pill}" HorizontalAlignment="Left" Background="#66000000" Padding="10,3">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Fill="{Binding SpotifyBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding SpotifyShort}" Margin="7,0,0,0" FontSize="11" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="24,20,24,22">
                            <TextBlock Text="{Binding SpotifyTitle}" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SpotifyArtist}" Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>

                            <TextBlock Text="KLEUREN VAN DIT NUMMER" Style="{StaticResource Overline}" Margin="0,22,0,10"/>
                            <ItemsControl x:Name="PaletteList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,12,0">
                                            <Border Width="56" Height="36" CornerRadius="8" Background="{Binding Converter={StaticResource HexToBrush}}"
                                                    BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"/>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoPalette" Text="Zodra er een nummer speelt, krijgt het zijn eigen kleuren. Hetzelfde nummer heeft altijd dezelfde kleuren."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap"/>

                            <TextBlock Text="GELUID" Style="{StaticResource Overline}" Margin="0,22,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Height="10" CornerRadius="5" Background="{StaticResource InputBrush}" VerticalAlignment="Center">
                                    <Border x:Name="LevelBar" HorizontalAlignment="Left" Width="0" CornerRadius="5" Background="{StaticResource AccentGradient}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                                    <Ellipse x:Name="BeatDot" Width="12" Height="12" Fill="{StaticResource Text3Brush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Beat" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="RaveBadge" Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,3"
                                    Background="{StaticResource AccentSoftBrush}" Visibility="Collapsed">
                                <TextBlock x:Name="RaveText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}"/>
                            </Border>
                            <TextBlock x:Name="StatsText" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Waarom lukt het niet? -->
                <Border x:Name="ProblemBox" Background="{StaticResource WarningSoftBrush}" CornerRadius="10" Padding="14,12" Margin="0,20,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ProblemTitle" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock x:Name="ProblemText" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Oplossing" FontWeight="SemiBold" Margin="0,10,0,0"/>
                        <TextBlock x:Name="ProblemSolution" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border x:Name="OnCard" Style="{StaticResource Card}" Margin="0,20,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Spotify-modus staat aan" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="BetterTok is uit. Ga je live? Schakel terug naar Stream-modus, dan sturen je TikTok-events de lampen weer."/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Tag="&#xE714;" Content="Naar Stream-modus" Margin="16,0,0,0" Click="EnableStream_Click"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== RECHTS: instellingen ===================== -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Lichtstijl" Style="{StaticResource H2}"/>
                        <Border Style="{StaticResource SegmentHost}" Margin="0,14,0,8">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="Op de beat" GroupName="SpStyle"
                                             IsChecked="{Binding Settings.Spotify.Style, Converter={StaticResource EnumEquals}, ConverterParameter=Beat}" Checked="Style_Checked"/>
                                <RadioButton Style="{StaticResource Segment}" Content="Rustig" GroupName="SpStyle"
                                             IsChecked="{Binding Settings.Spotify.Style, Converter={StaticResource EnumEquals}, ConverterParameter=Calm}" Checked="Style_Checked"/>
                                <RadioButton Style="{StaticResource Segment}" Content="Eén kleur" GroupName="SpStyle"
                                             IsChecked="{Binding Settings.Spotify.Style, Converter={StaticResource EnumEquals}, ConverterParameter=PerSong}" Checked="Style_Checked"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="StyleHelp" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,18"/>

                        <TextBlock Text="Rave / uptempo / zaag herkennen" Style="{StaticResource FieldLabel}"/>
                        <Border Style="{StaticResource SegmentHost}" Margin="0,6,0,8">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="Automatisch" GroupName="SpRave"
                                             IsChecked="{Binding Settings.Spotify.Rave, Converter={StaticResource EnumEquals}, ConverterParameter=Auto}"/>
                                <RadioButton Style="{StaticResource Segment}" Content="Altijd" GroupName="SpRave"
                                             IsChecked="{Binding Settings.Spotify.Rave, Converter={StaticResource EnumEquals}, ConverterParameter=Always}"/>
                                <RadioButton Style="{StaticResource Segment}" Content="Uit" GroupName="SpRave"
                                             IsChecked="{Binding Settings.Spotify.Rave, Converter={StaticResource EnumEquals}, ConverterParameter=Never}"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,18"
                                   Text="Hoort de app een raveplaat (128 BPM of sneller met een vaste kick, zoals uptempo, hardstyle en zaag), dan schakelt hij over op festival-licht zoals bij je dono-sounds: witte flash op elke kick, kleur op de ¼ beat, strobe elke 4e maat, en na 8 maten strip A/B om-en-om. In een break wordt het rustiger. Zet ‘Direct springen’ aan in Device Manager voor de snelle flashes."/>

                        <Grid>
                            <TextBlock Text="Helderheid" Style="{StaticResource FieldLabel}"/>
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource Caption}"><Run Text="{Binding Settings.Spotify.MaxBrightness, Mode=OneWay}"/><Run Text=" %"/></TextBlock>
                        </Grid>
                        <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Settings.Spotify.MaxBrightness}"/>
                        <TextBlock Text="Zachte stukken in een nummer worden automatisch wat minder fel. Daarbovenop geldt ‘Helderheid lichtshows’ uit Instellingen (voor je camera)." Style="{StaticResource Caption}" Margin="0,4,0,16" TextWrapping="Wrap"/>

                        <StackPanel x:Name="SensitivityPanel">
                            <Grid>
                                <TextBlock Text="Gevoeligheid voor beats" Style="{StaticResource FieldLabel}"/>
                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource Caption}"><Run Text="{Binding Settings.Spotify.Sensitivity, Mode=OneWay}"/></TextBlock>
                            </Grid>
                            <Slider Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.Spotify.Sensitivity}"/>
                            <TextBlock Text="Lager = alleen harde kicks. Hoger = reageert ook op zachtere klappen. Kijk naar het Beat-bolletje links." Style="{StaticResource Caption}" Margin="0,4,0,16" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel x:Name="CalmPanel">
                            <Grid>
                                <TextBlock Text="Seconden per kleur" Style="{StaticResource FieldLabel}"/>
                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource Caption}"><Run Text="{Binding Settings.Spotify.CalmSeconds, Mode=OneWay}"/><Run Text=" s"/></TextBlock>
                            </Grid>
                            <Slider Minimum="2" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.Spotify.CalmSeconds}"/>
                            <TextBlock Text="Elke kleur loopt zacht over in de volgende." Style="{StaticResource Caption}" Margin="0,4,0,16"/>
                        </StackPanel>

                        <StackPanel x:Name="EffectsPanel">
                            <CheckBox Style="{StaticResource Switch}" Content="Flashbangs (witte flitsen + wit-zwart-wit op de drop)" IsChecked="{Binding Settings.Spotify.Flashbangs}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="BlackoutSwitch" Style="{StaticResource Switch}" Content="Zwarte stukjes tussen de kleuren" IsChecked="{Binding Settings.Spotify.Blackouts}" Margin="0,0,0,10"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource Switch}" Content="Zacht licht als Spotify gepauzeerd is" IsChecked="{Binding Settings.Spotify.DimWhenPaused}"/>

                        <Border Style="{StaticResource Divider}" Margin="0,18,0,14"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8">
                            <Run Text="Licht eerder sturen:"/>
                            <Run Text="{Binding Settings.Lighting.LatencyMs, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" ms. Loopt het licht achter op de muziek? Meet het bij Instellingen › Verlichting › Vertraging meten."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                            <Run Text="Snelste kleurwissel:"/>
                            <Run Text="{Binding Settings.Lighting.MinChangeMs, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" ms (zelfde limiet als je lichtshows, aan te passen bij Instellingen › Verlichting)."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Zo werkt het" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="1. Open de Spotify-desktopapp op deze pc en speel een nummer af. Inloggen of koppelen in deze app is niet nodig."/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="2. De app leest welk nummer speelt en geeft elk nummer zijn eigen set van 4 felle kleuren."/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="3. Het geluid van je speakers of headset wordt gemeten om de beat te vinden. De kleur wisselt op de klap, maar nooit sneller dan je strip aankan."/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Text="Let op: de app meet al het geluid van je pc. Staat er ook een video of game aan, dan telt die mee voor de beat. Spotify in de browser of op je telefoon kan de app niet zien."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

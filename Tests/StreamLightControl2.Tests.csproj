<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test-runner voor de kernlogica. Draait ook zonder Windows: dotnet run in deze map -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StreamLightControl2.Tests</RootNamespace>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="SoundCheck\**" />
    <None Remove="SoundCheck\**" />
  </ItemGroup>
</Project>

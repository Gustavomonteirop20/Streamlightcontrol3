<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        STREAM LIGHT CONTROL – DESIGN TOKENS
        Eén plek voor alle kleuren, lettertypes en maten. Pas hier aan, dan verandert de hele app.
    -->

    <!-- Oppervlakken: van donker (zijbalk) naar licht (verhoogd) -->
    <Color x:Key="SidebarColor">#0D0E13</Color>
    <Color x:Key="BgColor">#121319</Color>
    <Color x:Key="CardColor">#191A22</Color>
    <Color x:Key="CardHoverColor">#1F2029</Color>
    <Color x:Key="ElevatedColor">#24262F</Color>
    <Color x:Key="InputColor">#14151B</Color>
    <Color x:Key="LineColor">#262833</Color>
    <Color x:Key="LineStrongColor">#353845</Color>

    <!-- Tekst -->
    <Color x:Key="TextColor">#ECECF1</Color>
    <Color x:Key="Text2Color">#A2A4B4</Color>
    <Color x:Key="Text3Color">#6E7184</Color>

    <!-- Accent: paars → blauw -->
    <Color x:Key="AccentColor">#7B6CF6</Color>
    <Color x:Key="AccentHoverColor">#8D80F9</Color>
    <Color x:Key="AccentPressedColor">#6A5AE6</Color>
    <Color x:Key="Accent2Color">#4F8DFF</Color>
    <Color x:Key="AccentSoftColor">#267B6CF6</Color>

    <!-- Status -->
    <Color x:Key="SuccessColor">#3FCF8E</Color>
    <Color x:Key="SuccessSoftColor">#203FCF8E</Color>
    <Color x:Key="WarningColor">#F5A524</Color>
    <Color x:Key="WarningSoftColor">#22F5A524</Color>
    <Color x:Key="DangerColor">#F2556F</Color>
    <Color x:Key="DangerSoftColor">#24F2556F</Color>
    <Color x:Key="InfoSoftColor">#224F8DFF</Color>
    <Color x:Key="LiveColor">#FF3B5C</Color>

    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}"/>
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="Text2Brush" Color="{StaticResource Text2Color}"/>
    <SolidColorBrush x:Key="Text3Brush" Color="{StaticResource Text3Color}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}"/>
    <SolidColorBrush x:Key="LiveBrush" Color="{StaticResource LiveColor}"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B6CF6" Offset="0"/>
        <GradientStop Color="#4F8DFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Typografie -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Maten -->
    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlRadius">8</CornerRadius>
    <Thickness x:Key="CardPadding">20</Thickness>
    <sys:Double x:Key="ControlHeight">36</sys:Double>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="22" ShadowDepth="3" Direction="270" Opacity="0.28" Color="#000000"/>
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000"/>
</ResourceDictionary>

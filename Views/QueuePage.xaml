<UserControl x:Class="StreamLightControl2.Views.QueuePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamLightControl2">
    <DockPanel Margin="24,22,24,24">
        <!-- Huidig effect -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="72" Height="72" CornerRadius="14" Background="{Binding FrameBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"/>
                <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock Text="HUIDIG EFFECT" Style="{StaticResource Overline}"/>
                    <TextBlock Text="{Binding Current.ShowName, TargetNullValue='Niets aan het afspelen', FallbackValue='Niets aan het afspelen'}" Style="{StaticResource H2}" FontSize="18" Margin="0,4,0,0"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                        <Run Text="{Binding Current.EventLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Current.User, Mode=OneWay}"/><Run Text=" · prioriteit "/><Run Text="{Binding Current.PriorityLabel, Mode=OneWay}"/>
                    </TextBlock>
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Margin="0,12,0,0" Width="360" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Tag="&#xE72A;" Content="Overslaan" Margin="0,0,8,0" Click="Skip_Click" IsEnabled="{Binding IsPlaying}"
                            ToolTip="Stop dit effect en ga direct door met het volgende"/>
                    <Button x:Name="StopButton" Style="{StaticResource SecondaryButton}" Tag="&#xE769;" Content="Stoppen" Margin="0,0,8,0" Click="Stop_Click"
                            ToolTip="Stop dit effect en pauzeer de wachtrij. Nieuwe events komen er wel bij."/>
                    <Button x:Name="ResumeButton" Style="{StaticResource PrimaryButton}" Tag="&#xE768;" Content="Hervatten" Margin="0,0,8,0" Click="Resume_Click" Visibility="Collapsed"/>
                    <Button Style="{StaticResource DangerButton}" Tag="&#xE74D;" Content="Wachtrij leegmaken" Click="Clear_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="PausedBanner" DockPanel.Dock="Top" Background="{StaticResource WarningSoftBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,16" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE769;" Style="{StaticResource Icon}" Foreground="{StaticResource WarningBrush}" FontSize="13"/>
                <TextBlock Text="De wachtrij is gepauzeerd. Klik op ‘Hervatten’ om verder te gaan." Margin="10,0,0,0" Foreground="{StaticResource WarningBrush}"/>
            </StackPanel>
        </Border>

        <!-- Volgende effecten -->
        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="20,18,20,12">
                    <TextBlock Style="{StaticResource H2}"><Run Text="Volgende effecten"/><Run Text="  "/><Run Text="{Binding QueueCount, Mode=OneWay}" Foreground="{StaticResource Text3Brush}"/></TextBlock>
                    <TextBlock Text="Hoogste prioriteit eerst, daarna wie het eerst kwam." Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Background="{StaticResource InputBrush}" Padding="32,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="#" Style="{StaticResource Overline}"/>
                        <TextBlock Grid.Column="1" Text="LICHTSHOW" Style="{StaticResource Overline}"/>
                        <TextBlock Grid.Column="2" Text="GEBRUIKER" Style="{StaticResource Overline}"/>
                        <TextBlock Grid.Column="3" Text="EVENT" Style="{StaticResource Overline}"/>
                        <TextBlock Grid.Column="4" Text="PRIORITEIT" Style="{StaticResource Overline}"/>
                        <TextBlock Grid.Column="5" Text="WACHTTIJD" Style="{StaticResource Overline}"/>
                    </Grid>
                </Border>
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding QueueCount, Converter={StaticResource CountToVis}, ConverterParameter=zero}">
                        <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="34" Foreground="{StaticResource Text3Brush}"/>
                        <TextBlock Text="De wachtrij is leeg" Style="{StaticResource H3}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="Komen er meerdere events tegelijk binnen, dan wachten ze hier netjes op hun beurt." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Pending}" ItemContainerStyle="{StaticResource RowItem}" Padding="8,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="1.4*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Position}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Item.ShowName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Item.User}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Item.EventLabel}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="4" Margin="0,0,16,0" ItemsSource="{x:Static local:Options.PriorityList}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Item.Priority, Mode=OneWay}" SelectionChanged="Priority_Changed" Tag="{Binding Item}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Wait}" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
                                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Tag="&#xE70E;" CommandParameter="{Binding Item}" Click="Up_Click" ToolTip="Eerder afspelen"/>
                                        <Button Style="{StaticResource IconButton}" Tag="&#xE70D;" CommandParameter="{Binding Item}" Click="Down_Click" ToolTip="Later afspelen"/>
                                        <Button Style="{StaticResource IconButton}" Tag="&#xE711;" CommandParameter="{Binding Item}" Click="Remove_Click" ToolTip="Uit de wachtrij halen"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>

<UserControl x:Class="StreamLightControl2.Views.GiftManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamLightControl2"
             xmlns:ui="clr-namespace:StreamLightControl2.Controls">
    <UserControl.Resources>
        <!-- Gedeelde kolommen voor een regel -->
        <DataTemplate x:Key="RangeRow">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}"/>
                <TextBox Grid.Column="1" Text="{Binding MinCoins, TargetNullValue=''}" ui:Hint.Text="0" ToolTip="Vanaf dit aantal coins (inclusief)"/>
                <TextBlock Grid.Column="2" Text="–" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Text3Brush}"/>
                <TextBox Grid.Column="3" Text="{Binding MaxCoins, TargetNullValue=''}" ui:Hint.Text="∞" ToolTip="Tot en met dit aantal coins. Leeg = geen bovengrens."/>
                <ComboBox Grid.Column="4" Margin="10,0,0,0" ItemsSource="{Binding DataContext.Settings.Shows, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ShowId}"/>
                <ComboBox Grid.Column="5" Margin="10,0,0,0" ItemsSource="{x:Static local:Options.PriorityList}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Priority}"/>
                <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Style="{StaticResource IconButton}" Tag="&#xE768;" CommandParameter="{Binding}" Click="Test_Click" ToolTip="Test op je lampen"/>
                    <Button Style="{StaticResource IconButton}" Tag="&#xE74D;" CommandParameter="{Binding}" Click="Delete_Click" ToolTip="Verwijderen"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="NamedRow">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}"/>
                <TextBox Grid.Column="1" Text="{Binding GiftNames}" ui:Hint.Text="Rose, Heart Me" ToolTip="Een of meer giftnamen, gescheiden door komma's. Ze spelen allemaal dezelfde show."/>
                <ComboBox Grid.Column="2" Margin="10,0,0,0" ItemsSource="{Binding DataContext.Settings.Shows, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ShowId}"/>
                <ComboBox Grid.Column="3" Margin="10,0,0,0" ItemsSource="{x:Static local:Options.PriorityList}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Priority}"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Style="{StaticResource IconButton}" Tag="&#xE768;" CommandParameter="{Binding}" Click="Test_Click" ToolTip="Test op je lampen"/>
                    <Button Style="{StaticResource IconButton}" Tag="&#xE74D;" CommandParameter="{Binding}" Click="Delete_Click" ToolTip="Verwijderen"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,22,24,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <!-- Regelbouwer: coin-bereiken -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Regelbouwer: coin-bereiken" Style="{StaticResource H2}"/>
                                <TextBlock Text="Welke lichtshow bij hoeveel coins. Coins = waarde van de gift × aantal (een hele combo telt als één gift)."
                                           Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource PrimaryButton}" Tag="&#xE710;" Content="Bereik toevoegen" HorizontalAlignment="Right" VerticalAlignment="Top" Click="AddRange_Click"/>
                        </Grid>
                        <Grid Margin="0,18,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ACTIEF" Style="{StaticResource Overline}"/>
                            <TextBlock Grid.Column="1" Text="VANAF" Style="{StaticResource Overline}"/>
                            <TextBlock Grid.Column="3" Text="TOT EN MET" Style="{StaticResource Overline}"/>
                            <TextBlock Grid.Column="4" Text="LICHTSHOW" Style="{StaticResource Overline}" Margin="10,0,0,0"/>
                            <TextBlock Grid.Column="5" Text="PRIORITEIT" Style="{StaticResource Overline}" Margin="10,0,0,0"/>
                        </Grid>
                        <ItemsControl x:Name="RangeList" ItemTemplate="{StaticResource RangeRow}"/>
                        <TextBlock x:Name="NoRangesText" Text="Nog geen coin-bereiken. Voeg er een toe, bijvoorbeeld 1 – 99 coins." Style="{StaticResource Caption}" Visibility="Collapsed" Margin="0,6"/>

                        <!-- Waarschuwingen -->
                        <Border x:Name="WarningsBox" Background="{StaticResource WarningSoftBrush}" CornerRadius="10" Padding="14,12" Margin="0,16,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource WarningBrush}" FontSize="14"/>
                                    <TextBlock Text="Controleer je regels" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                                </StackPanel>
                                <ItemsControl x:Name="WarningsList" Margin="22,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" Margin="0,2"/></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border x:Name="OkBox" Background="{StaticResource SuccessSoftBrush}" CornerRadius="10" Padding="14,10" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{StaticResource SuccessBrush}" FontSize="13"/>
                                <TextBlock Text="Geen overlap of gaten. Elke gift speelt precies één effect." Margin="8,0,0,0" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Specifieke gifts -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Specifieke gifts" Style="{StaticResource H2}"/>
                                <TextBlock Text="Een eigen effect voor bepaalde gifts. Gaat altijd vóór de coin-bereiken. Meerdere gifts → zelfde show: scheid de namen met komma's."
                                           Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Style="{StaticResource SecondaryButton}" Tag="&#xE710;" Content="Gift toevoegen" HorizontalAlignment="Right" VerticalAlignment="Top" Click="AddNamed_Click"/>
                        </Grid>
                        <ItemsControl x:Name="NamedList" ItemTemplate="{StaticResource NamedRow}" Margin="0,16,0,0"/>
                        <TextBlock x:Name="NoNamedText" Text="Nog geen specifieke gifts. Tip: koppel een herkende gift via het paneel rechts." Style="{StaticResource Caption}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <!-- Tester -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Welke regel wint?" Style="{StaticResource H2}"/>
                        <TextBlock Text="Vul een gift in en zie direct welk effect er speelt." Style="{StaticResource Caption}" Margin="0,4,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TestName" ui:Hint.Text="Giftnaam (optioneel)" TextChanged="Tester_Changed"/>
                            <TextBox x:Name="TestCoins" Grid.Column="2" Text="250" ui:Hint.Text="Coins" TextChanged="Tester_Changed"/>
                        </Grid>
                        <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock x:Name="TesterResult" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TesterDetail" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource SecondaryButton}" Tag="&#xE768;" Content="Simuleer deze gift" Margin="0,12,0,0" HorizontalAlignment="Left" Click="SimulateGift_Click"
                                ToolTip="Stuurt deze gift door de echte verwerking, inclusief wachtrij en lampen"/>
                    </StackPanel>
                </Border>

                <!-- Herkende gifts -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Herkende gifts" Style="{StaticResource H2}"/>
                        <TextBlock Text="Gifts die je echt hebt ontvangen (uit Event History)." Style="{StaticResource Caption}" Margin="0,4,0,12"/>
                        <TextBlock x:Name="NoSeenText" Text="Nog geen gifts ontvangen." Style="{StaticResource Caption}"/>
                        <ItemsControl x:Name="SeenList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding CoinsText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Times, Mode=OneWay}"/><Run Text="× ontvangen"/></TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="{Binding ActionText}" IsEnabled="{Binding CanLink}"
                                                CommandParameter="{Binding Name}" Click="LinkSeen_Click" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Combo's -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="Combo's en dubbele effecten" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,14"
                                   Text="Een kijker die 10× achter elkaar een Rose stuurt, maakt een combo. Om te voorkomen dat er 10 effecten afspelen, wacht de app standaard tot de combo klaar is."/>
                        <RadioButton Content="Eén effect aan het eind van de combo (aanbevolen)" GroupName="Streak" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"
                                     IsChecked="{Binding Settings.Gift.StreakMode, Converter={StaticResource EnumEquals}, ConverterParameter=AtEnd}"/>
                        <RadioButton Content="Bij elke update van de combo" GroupName="Streak" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"
                                     IsChecked="{Binding Settings.Gift.StreakMode, Converter={StaticResource EnumEquals}, ConverterParameter=EveryUpdate}"/>
                        <Grid>
                            <TextBlock Text="Cloud Mode: naschot negeren (s)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"
                                       ToolTip="BetterTok Cloud kan na een combo nog een melding met het restant sturen. Binnen deze tijd wordt die samengevoegd met de combo (zelfde kijker + zelfde gift)."/>
                            <TextBox Style="{StaticResource NumberBox}" HorizontalAlignment="Right" Width="70" Text="{Binding Settings.Gift.CloudComboMergeSeconds}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="StreamLightControl2.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,26,32,36">

            <!-- Welkom + Start/Stop -->
            <Grid Margin="0,0,0,24">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Greeting" Text="Welkom" Style="{StaticResource H1}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Ellipse Width="8" Height="8" Fill="{Binding OverallBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding OverallText}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="StartStopButton" HorizontalAlignment="Right" VerticalAlignment="Center" MinHeight="44" Padding="22,0" FontSize="14"
                        Click="StartStop_Click" ToolTip="Start of stop het automatisch afspelen van lichtshows bij TikTok-events."/>
            </Grid>

            <!-- Statistieken -->
            <Grid Margin="0,0,0,10">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Overline}">
                    <Run Text="DEZE SESSIE"/> <Run x:Name="SinceRun" Text=""/>
                </TextBlock>
                <Button Style="{StaticResource GhostButton}" Tag="&#xE70F;" Content="Aanpassen" HorizontalAlignment="Right" MinHeight="28" Height="28"
                        Click="CustomizeStats_Click" ToolTip="Kies welke statistieken je hier ziet."/>
            </Grid>
            <Border x:Name="StatsCustomizer" Style="{StaticResource Panel}" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Welke statistieken wil je zien?" Style="{StaticResource FieldLabel}"/>
                    <WrapPanel x:Name="StatsChecks"/>
                </StackPanel>
            </Border>
            <ItemsControl x:Name="StatsGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoftBrush}">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource AccentHoverBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Value}" Style="{StaticResource StatValue}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LINKS -->
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Laatste events" Style="{StaticResource H2}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Alles bekijken" HorizontalAlignment="Right" MinHeight="28" Height="28" Click="GoHistory_Click"/>
                            </Grid>
                            <TextBlock Text="Nog geen events ontvangen. Zodra iemand je volgt, een like of een gift stuurt, zie je het hier."
                                       Style="{StaticResource Caption}" Margin="0,6,0,6"
                                       Visibility="{Binding Recent.Count, Converter={StaticResource CountToVis}, ConverterParameter=zero}"/>
                            <ItemsControl ItemsSource="{Binding Recent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource ElevatedBrush}">
                                                <TextBlock Text="{Binding Type, Converter={StaticResource EventIcon}}" Style="{StaticResource Icon}" FontSize="14"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding User}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Pill}" Background="{Binding Status, Converter={StaticResource StatusToSoftBrush}}" ToolTip="{Binding Detail}">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding Time, StringFormat=HH:mm:ss}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Snelle acties" Style="{StaticResource H2}"/>
                            <TextBlock Text="Direct naar al je actieve lampen." Style="{StaticResource Caption}" Margin="0,4,0,14"/>
                            <UniformGrid Columns="8" x:Name="QuickGrid">
                                <Button Style="{StaticResource QuickButton}" CommandParameter="on" Click="Quick_Click" ToolTip="Alle actieve lampen aan">
                                    <StackPanel><TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource SuccessBrush}"/><TextBlock Text="Aan" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuickButton}" CommandParameter="off" Click="Quick_Click" ToolTip="Alle actieve lampen uit (stopt ook de wachtrij)">
                                    <StackPanel><TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="18"/><TextBlock Text="Uit" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuickButton}" CommandParameter="rainbow" Click="Quick_Click" ToolTip="Speel de Rainbow-preset af">
                                    <StackPanel><Border Width="22" Height="22" CornerRadius="11"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF1A1A" Offset="0"/><GradientStop Color="#FFE600" Offset="0.35"/><GradientStop Color="#1AFF4A" Offset="0.6"/><GradientStop Color="#7B6CF6" Offset="1"/></LinearGradientBrush></Border.Background></Border><TextBlock Text="Rainbow" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuickButton}" CommandParameter="red" Click="Quick_Click" ToolTip="Stopt het lopende effect en zet rood">
                                    <StackPanel><Border Width="22" Height="22" CornerRadius="11" Background="#FF1A1A"/><TextBlock Text="Rood" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuickButton}" CommandParameter="green" Click="Quick_Click" ToolTip="Stopt het lopende effect en zet groen">
                                    <StackPanel><Border Width="22" Height="22" CornerRadius="11" Background="#1AFF4A"/><TextBlock Text="Groen" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuickButton}" CommandParameter="blue" Click="Quick_Click" ToolTip="Stopt het lopende effect en zet blauw">
                                    <StackPanel><Border Width="22" Height="22" CornerRadius="11" Background="#1A4DFF"/><TextBlock Text="Blauw" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuickButton}" CommandParameter="white" Click="Quick_Click" ToolTip="Stopt het lopende effect en zet wit">
                                    <StackPanel><Border Width="22" Height="22" CornerRadius="11" Background="#FFFFFF"/><TextBlock Text="Wit" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuickButton}" CommandParameter="stop" Click="Quick_Click" ToolTip="Stopt het lopende effect en maakt de wachtrij leeg">
                                    <StackPanel><TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource DangerBrush}"/><TextBlock Text="Stop alles" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RECHTS -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Nu actief" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="58" Height="58" CornerRadius="12" Background="{Binding FrameBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                                        ToolTip="De kleur die nu naar je lampen is gestuurd"/>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Current.ShowName, FallbackValue='Niets aan het afspelen', TargetNullValue='Niets aan het afspelen'}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                                        <Run Text="{Binding Current.EventLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Current.User, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="De volgende lichtshow start zodra er een event binnenkomt." Style="{StaticResource Caption}" Margin="0,3,0,0"
                                               Visibility="{Binding IsPlaying, Converter={StaticResource InvBoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Margin="0,16,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource SmallButton}" Tag="&#xE72A;" Content="Overslaan" Margin="0,0,8,0" Click="Skip_Click"
                                        IsEnabled="{Binding IsPlaying}" ToolTip="Stop dit effect en ga door met het volgende in de wachtrij"/>
                                <Button Style="{StaticResource SmallButton}" Tag="&#xE71A;" Content="Stop alles" Click="StopAll_Click"
                                        ToolTip="Stop het effect en maak de wachtrij leeg"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource H2}"><Run Text="Volgende in de wachtrij"/></TextBlock>
                                <Button Style="{StaticResource GhostButton}" Content="Openen" HorizontalAlignment="Right" MinHeight="28" Height="28" Click="GoQueue_Click"/>
                            </Grid>
                            <TextBlock Text="De wachtrij is leeg." Style="{StaticResource Caption}" Visibility="{Binding QueueCount, Converter={StaticResource CountToVis}, ConverterParameter=zero}"/>
                            <ItemsControl ItemsSource="{Binding Pending}" MaxHeight="190">
                                <ItemsControl.Template>
                                    <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Position}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Item.ShowName}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding Item.EventLabel, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Item.User, Mode=OneWay}"/></TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Wait}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Verbindingen" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                            <Grid Margin="0,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding BetterTokBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Text="BetterTok" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding BetterTokText}" Style="{StaticResource Caption}"/>
                                        <TextBlock Text="{Binding LastMessageText}" Style="{StaticResource Caption}" Visibility="{Binding LastMessageText, Converter={StaticResource NullToVis}}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Style="{StaticResource SmallButton}" Content="Beheren" HorizontalAlignment="Right" VerticalAlignment="Center" Click="GoBetterTok_Click"/>
                            </Grid>
                            <Border Style="{StaticResource Divider}" Margin="0,12"/>
                            <TextBlock Text="Nog geen Govee-apparaat toegevoegd." Style="{StaticResource Caption}"
                                       Visibility="{Binding Settings.Devices.Count, Converter={StaticResource CountToVis}, ConverterParameter=zero}"/>
                            <ItemsControl ItemsSource="{Binding Settings.Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource Text3Brush}" VerticalAlignment="Center"/>
                                                <StackPanel Margin="12,0,0,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding Ip, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding OnlineLabel, Mode=OneWay}"/></TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Online}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Online}" Value="False"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter TargetName="Dot" Property="Opacity" Value="0.35"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource SmallButton}" Content="Device Manager" HorizontalAlignment="Left" Margin="0,12,0,0" Click="GoDevices_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

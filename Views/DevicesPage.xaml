<UserControl x:Class="StreamLightControl2.Views.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:StreamLightControl2.Controls">
    <UserControl.Resources>
        <Style x:Key="DeviceItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,22,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <!-- Werkbalk -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Govee-apparaten" Style="{StaticResource H2}"/>
                            <TextBlock Text="Besturing via Govee LAN Control (lokaal netwerk, geen cloud). Je H619E moet LAN Control aan hebben staan in de Govee Home-app."
                                       Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="DiscoverButton" Style="{StaticResource PrimaryButton}" Tag="&#xE721;" Content="Apparaten zoeken" Margin="0,0,8,0" Click="Discover_Click"
                                ToolTip="Zoekt alle Govee-lampen met LAN Control op je netwerk (ca. 3 seconden)"/>
                        <Button Style="{StaticResource SecondaryButton}" Tag="&#xE710;" Content="Handmatig toevoegen" Click="ShowManual_Click"
                                ToolTip="Voeg een lamp toe met zijn IP-adres (te vinden in je router of in de Govee-app)"/>
                    </StackPanel>
                    <Border x:Name="ManualForm" Style="{StaticResource Panel}" Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="IP-adres" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ManualIp" ui:Hint.Text="192.168.1.50"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Naam" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ManualName" Text="Govee H619E"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Toevoegen" Margin="0,0,6,0" Click="AddManual_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="Annuleren" Click="HideManual_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Zoekresultaten -->
                    <Border x:Name="FoundPanel" Style="{StaticResource Panel}" Margin="0,14,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="FoundTitle" Style="{StaticResource H3}"/>
                            <ItemsControl x:Name="FoundList" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <TextBlock VerticalAlignment="Center"><Run Text="{Binding Sku, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  "/><Run Text="{Binding Ip, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Mac, Mode=OneWay}" Foreground="{StaticResource Text3Brush}"/></TextBlock>
                                            <Button Style="{StaticResource SmallButton}" Content="Toevoegen" HorizontalAlignment="Right" CommandParameter="{Binding}" Click="AddFound_Click"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Hulp -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel}" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="LAN Control inschakelen" Style="{StaticResource H3}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                               Text="Open de Govee Home-app → tik op je H619E → tandwiel (instellingen) → zet ‘LAN Control’ aan. Pc en lamp moeten op hetzelfde wifi-netwerk zitten (niet het gastnetwerk). Vraagt Windows om netwerktoegang? Kies ‘Privénetwerk’."/>
                </StackPanel>
            </Border>

            <Grid>
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xE772;" Style="{StaticResource Icon}" FontSize="40" Foreground="{StaticResource Text3Brush}"/>
                    <TextBlock Text="Nog geen apparaten" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="Klik op ‘Apparaten zoeken’ of voeg je lamp handmatig toe." Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
                <ListBox x:Name="DeviceList" ItemsSource="{Binding Settings.Devices}" ItemContainerStyle="{StaticResource DeviceItem}" SelectionChanged="DeviceList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                                        <TextBlock Text="&#xEA80;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource AccentHoverBrush}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3}"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                            <Run Text="{Binding Sku, Mode=OneWay, TargetNullValue='Govee'}"/><Run Text="  ·  "/><Run Text="{Binding Ip, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Mac, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="StatusPill" Style="{StaticResource Pill}" Margin="0,0,14,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource Text3Brush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding OnlineLabel}" FontSize="11" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <CheckBox Style="{StaticResource Switch}" Content="Gebruiken" IsChecked="{Binding Enabled}"
                                                  ToolTip="Aan = deze lamp doet mee met lichtshows en snelle acties"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="56,14,0,0">
                                    <Button Style="{StaticResource SmallButton}" Tag="&#xE703;" Content="Test verbinding" Margin="0,0,6,0" CommandParameter="{Binding}" Click="TestConn_Click"
                                            ToolTip="Vraagt de status op bij de lamp. Antwoord = LAN Control werkt."/>
                                    <Button Style="{StaticResource SmallButton}" Tag="&#xE72C;" Content="Opnieuw verbinden" Margin="0,0,6,0" CommandParameter="{Binding}" Click="Reconnect_Click"
                                            ToolTip="Zoekt de lamp opnieuw op het netwerk en werkt het IP-adres bij als dat veranderd is"/>
                                    <Button Style="{StaticResource SmallButton}" Tag="&#xE8AC;" Content="Hernoemen" Margin="0,0,6,0" CommandParameter="{Binding}" Click="Rename_Click"/>
                                    <Button Style="{StaticResource SmallButton}" Tag="&#xE74D;" Content="Verwijderen" CommandParameter="{Binding}" Click="Remove_Click" Foreground="{StaticResource DangerBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Online}" Value="True">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                    <Setter TargetName="StatusPill" Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Online}" Value="False">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource DangerBrush}"/>
                                    <Setter TargetName="StatusPill" Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>

        <!-- Bediening -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <TextBlock x:Name="NoDeviceText" Text="Selecteer een apparaat om het te bedienen." Style="{StaticResource Muted}"/>
                <ScrollViewer x:Name="ControlPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding OnlineLabel}" Style="{StaticResource Caption}" Margin="0,4,0,16"/>

                        <Border Style="{StaticResource Panel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="StatusSwatch" Width="44" Height="44" CornerRadius="10" Background="#000000" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"/>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusLine1" Text="Status onbekend" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StatusLine2" Text="Klik op ‘Status ophalen’." Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Button Style="{StaticResource GhostButton}" Tag="&#xE72C;" Content="Status ophalen" HorizontalAlignment="Left" Margin="-8,6,0,10" Click="RefreshStatus_Click"/>

                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Button Style="{StaticResource SecondaryButton}" Tag="&#xE7E8;" Content="Aan" Margin="0,0,6,0" Click="On_Click"/>
                            <Button Style="{StaticResource SecondaryButton}" Tag="&#xE7E8;" Content="Uit" Margin="6,0,0,0" Click="Off_Click"/>
                        </UniformGrid>

                        <Grid>
                            <TextBlock Text="Helderheid" Style="{StaticResource FieldLabel}"/>
                            <TextBlock x:Name="BrightnessValue" Text="60%" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="BrightnessSlider" Minimum="1" Maximum="100" Value="60" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="Brightness_ValueChanged" Thumb.DragCompleted="Brightness_DragCompleted" PreviewMouseLeftButtonUp="Brightness_MouseUp"
                                ToolTip="Loslaten = toepassen"/>

                        <TextBlock Text="Kleur" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                        <ui:ColorPicker x:Name="DevicePicker" SelectedHex="#7B6CF6"/>
                        <Button Style="{StaticResource PrimaryButton}" Tag="&#xE790;" Content="Kleur toepassen" Margin="0,14,0,0" HorizontalAlignment="Stretch" Click="ApplyColor_Click"/>
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="14,12" Margin="0,16,0,8">
                            <StackPanel>
                                <CheckBox x:Name="DirectSwitch" Style="{StaticResource Switch}" Content="Kleuren direct laten springen (geen fade)" IsChecked="{Binding Settings.Lighting.DirectColor}"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,10"
                                           Text="Gebruikt het realtime-protocol van Govee (zoals schermsync / Razer Chroma). De kleur springt meteen in plaats van zacht over te lopen, en snellere wissels zijn mogelijk. Test eerst of jouw strip het kent."/>
                                <Button Style="{StaticResource SecondaryButton}" Tag="&#xE945;" Content="Test: direct springen" HorizontalAlignment="Stretch" Click="DirectTest_Click"
                                        ToolTip="Wisselt 3 seconden rood/blauw/groen in de directe modus en daarna in de gewone modus, zodat je het verschil ziet."/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource PrimaryButton}" Tag="&#xEC4A;" Content="Snelheidstest" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="SpeedTest_Click"
                                ToolTip="Laat je strip steeds sneller wit/zwart knipperen. Daarna kies je tot waar hij het bijhield; alle shows passen zich daarop aan."/>
                        <Button Style="{StaticResource SecondaryButton}" Tag="&#xEA80;" Content="Testkleur sturen" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="TestColor_Click"
                                ToolTip="Laat de lamp 2× paars knipperen en zet hem daarna terug zoals hij was"/>

                        <Border Background="{StaticResource ElevatedBrush}" CornerRadius="10" Padding="14,12" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Zones op stream (test)" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,10"
                                           Text="Zoek uit welke stukjes van de strip op stream te zien zijn. De test laat zone voor zone geel oplichten (de rest zacht blauw) en toont hieronder het nummer. Kijk mee in je stream-preview en schrijf op welke nummers je ziet. Probeer eerst A; doet de strip niets of de hele strip tegelijk, probeer dan B."/>
                                <TextBlock Text="Aantal zones" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ZoneCount, UpdateSourceTrigger=LostFocus}" Width="90" HorizontalAlignment="Left"
                                         ToolTip="Methode A: probeer 20 (standaard). Methode B: maximaal 16 segmenten; de H619E heeft er meestal 15."/>
                                <Button Style="{StaticResource SecondaryButton}" Content="A: Direct-zones langslopen" Margin="0,10,0,0" HorizontalAlignment="Stretch" Click="ZonesDirect_Click"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="B: Segmenten langslopen (onofficieel)" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="ZonesSegment_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="Test stoppen" Margin="0,8,0,0" HorizontalAlignment="Left" Click="ZonesStop_Click"/>
                                <TextBlock x:Name="ZoneNow" Text="" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <TextBlock Text="Methode die werkte" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                                <ComboBox x:Name="ZoneMethodBox" SelectedValuePath="Tag" SelectedValue="{Binding ZoneMethod}">
                                    <ComboBoxItem Tag="direct" Content="A: Direct-zones"/>
                                    <ComboBoxItem Tag="segment" Content="B: Segmenten"/>
                                </ComboBox>
                                <TextBlock Text="Welke zones zie je op stream?" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                                <TextBox Text="{Binding VisibleZones, UpdateSourceTrigger=LostFocus}" ui:Hint.Text="bijv. 1-3, 18-20"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="Laat alleen deze zones oplichten" Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="ZonesShowVisible_Click"
                                        ToolTip="Controle: de zones die je invulde worden 5 seconden warm geel, de rest gaat uit."/>
                                <CheckBox Style="{StaticResource Switch}" Content="Rustige shows (minder knipperen)" Margin="0,12,0,0"
                                          IsChecked="{Binding DataContext.Settings.Lighting.CalmShows, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          ToolTip="Zoals in je voorbeeldfilmpje: per stuk van het nummer één kleur, geen witte flitsen; de zichtbare zones bewegen op elke beat (onder de 3 wissels per seconde). De zichtbare zones bewegen op de beat (om-en-om, vullen, looplicht, vanuit het midden, ademen); de rest van de strip is een rustige gloed. Uit = de felle festival-shows."/>
                                <CheckBox Style="{StaticResource Switch}" Content="Effecten op de zichtbare zones" Margin="0,8,0,0"
                                          IsChecked="{Binding DataContext.Settings.Lighting.ZoneEffects, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          ToolTip="De zichtbare stukjes krijgen beams om-en-om, een scanner, licht vanuit het midden en washes in magenta/rood/paars; de rest van de strip houdt de showkleur. Op de kicks gaat alles wit. Gezellige shows krijgen een zacht kleurverloop."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

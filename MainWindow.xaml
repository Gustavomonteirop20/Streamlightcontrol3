<Window x:Class="StreamLightControl2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:StreamLightControl2.Controls"
        Title="Stream Light Control" Icon="Assets/app.ico" Width="1440" Height="900" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <!-- ===================== VOLLEDIGE WEERGAVE ===================== -->
        <Grid x:Name="FullRoot">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Zijbalk -->
            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,18,14,14">
                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentGradient}">
                            <TextBlock Text="&#xEA80;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Stream Light" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Control" Style="{StaticResource Caption}" Margin="0,-1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Modus: Stream (BetterTok) of Spotify -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                        <TextBlock Text="MODUS" Style="{StaticResource Overline}" Margin="6,0,0,8"/>
                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch"
                                ToolTip="Stream: TikTok-events via BetterTok sturen je lampen. Spotify: het nummer dat speelt stuurt je lampen. Er staat er altijd maar één aan.">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="ModeStream" Style="{StaticResource Segment}" GroupName="AppMode" Click="ModeStream_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Stream" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ModeSpotify" Style="{StaticResource Segment}" GroupName="AppMode" Click="ModeSpotify_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Spotify" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <!-- Status onderaan -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Style="{StaticResource Divider}" Margin="0,8,0,12"/>
                        <Button Style="{StaticResource GhostButton}" Padding="8,0" Height="38" HorizontalContentAlignment="Left" Click="GoSpotify_Click"
                                Visibility="{Binding IsSpotifyMode, Converter={StaticResource BoolToVis}}"
                                ToolTip="Spotify-modus: welk nummer er speelt. Klik voor details.">
                            <Grid Width="180">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding SpotifyBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Spotify" Margin="10,0,0,0" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SpotifyShort}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Text3Brush}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="8,0" Height="38" HorizontalContentAlignment="Left" Click="GoBetterTok_Click"
                                ToolTip="{Binding DonateWaveText}">
                            <Grid Width="180">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding DonateWaveBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="DonateWave" Margin="10,0,0,0" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DonateWaveShort}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Text3Brush}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="8,0" Height="38" HorizontalContentAlignment="Left" Click="GoBetterTok_Click"
                                Visibility="{Binding IsStreamMode, Converter={StaticResource BoolToVis}}"
                                ToolTip="Verbinding met BetterTok (TikTok-events). Klik voor details.">
                            <Grid Width="180">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding BetterTokBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="BetterTok" Margin="10,0,0,0" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="{Binding BetterTokShort}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Text3Brush}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Padding="8,0" Height="38" HorizontalContentAlignment="Left" Click="GoDevices_Click"
                                ToolTip="Verbinding met je Govee-lampen via LAN Control. Klik voor details.">
                            <Grid Width="180">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding GoveeBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Govee" Margin="10,0,0,0" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="{Binding GoveeText}" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Text3Brush}"/>
                            </Grid>
                        </Button>
                        <Grid Margin="8,10,0,0">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}">
                                <Run Text="Versie"/> <Run Text="{Binding Version, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Style="{StaticResource IconButton}" Tag="&#xE713;" HorizontalAlignment="Right" Click="GoSettings_Click" ToolTip="Instellingen"/>
                        </Grid>
                    </StackPanel>

                    <!-- Navigatie -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NavPanel">
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Dashboard" x:Name="NavDashboard" Checked="Nav_Checked" CommandParameter="dashboard"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE790;" Content="Light Shows" Checked="Nav_Checked" CommandParameter="shows"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE945;" Content="Event Manager" Checked="Nav_Checked" CommandParameter="events"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE734;" Content="Gift Manager" Checked="Nav_Checked" CommandParameter="gifts"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8FA;" Content="Follow Manager" Checked="Nav_Checked" CommandParameter="follows"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8D6;" Content="Spotify" Checked="Nav_Checked" CommandParameter="spotify"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE772;" Content="Device Manager" Checked="Nav_Checked" CommandParameter="devices"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE81C;" Content="Event History" Checked="Nav_Checked" CommandParameter="history"/>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Instellingen" Checked="Nav_Checked" CommandParameter="settings"/>

                            <TextBlock Text="SYSTEEM" Style="{StaticResource Overline}" Margin="14,20,0,8"/>
                            <Grid>
                                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE8FD;" Content="Wachtrij" Checked="Nav_Checked" CommandParameter="queue"/>
                                <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" Margin="0,0,10,0" Background="{StaticResource AccentSoftBrush}" Padding="7,1"
                                        IsHitTestVisible="False" Visibility="{Binding QueueCount, Converter={StaticResource CountToVis}}">
                                    <TextBlock Text="{Binding QueueCount}" FontSize="11" Foreground="{StaticResource AccentHoverBrush}"/>
                                </Border>
                            </Grid>
                            <RadioButton Style="{StaticResource NavItem}" Tag="&#xE71B;" Content="BetterTok" Checked="Nav_Checked" CommandParameter="bettertok"/>
                            <Grid>
                                <RadioButton Style="{StaticResource NavItem}" Tag="&#xE7BA;" Content="Error Center" Checked="Nav_Checked" CommandParameter="errors"/>
                                <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" Margin="0,0,10,0" Background="{StaticResource DangerSoftBrush}" Padding="7,1"
                                        IsHitTestVisible="False" Visibility="{Binding ErrorCount, Converter={StaticResource CountToVis}}">
                                    <TextBlock Text="{Binding ErrorCount}" FontSize="11" Foreground="{StaticResource DangerBrush}"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Inhoud -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="68"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Bovenbalk -->
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="32,0,24,0">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Text="Dashboard" Style="{StaticResource H2}" FontSize="18"/>
                            <TextBlock x:Name="PageSubtitle" Text="" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="SavedIndicator" Text="&#xE73E;  Opgeslagen" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource SuccessBrush}"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0" Opacity="0"/>
                            <!-- LIVE-indicator -->
                            <Border CornerRadius="15" Padding="12,6" Margin="0,0,10,0" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource CardBrush}"
                                    ToolTip="Stream-modus: LIVE = automatisering staat aan én BetterTok is verbonden. Spotify-modus: toont of er een nummer speelt.">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="{Binding LiveBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LiveText}" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="SafeModeButton" Style="{StaticResource SecondaryButton}" Tag="&#xEA18;" Content="Safe Mode" Margin="0,0,8,0" Click="SafeMode_Click"
                                    ToolTip="Zet alle automatiseringen direct uit. Je instellingen blijven bewaard."/>
                            <Button Style="{StaticResource SecondaryButton}" Tag="&#xE7F4;" Content="Stream Mode" Click="StreamMode_Click"
                                    ToolTip="Compacte weergave met alleen de belangrijkste knoppen, handig tijdens je stream."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>

                <!-- Update-melding -->
                <Border x:Name="UpdateBanner" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="24,0,0,24" Visibility="Collapsed"
                        Style="{StaticResource Card}" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource AccentBrush}" Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,12,0"/>
                        <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Nu bijwerken" MinHeight="30" Padding="12,0" Margin="0,0,6,0" Click="UpdateNow_Click"/>
                        <Button Style="{StaticResource GhostButton}" Content="Later" MinHeight="30" Height="30" Click="UpdateLater_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===================== STREAM MODE ===================== -->
        <ContentControl x:Name="StreamHost" Visibility="Collapsed" Focusable="False"/>

        <!-- ===================== MELDINGEN ===================== -->
        <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Width="360" IsHitTestVisible="False"/>

        <!-- ===================== DIALOOG ===================== -->
        <Grid x:Name="DialogHost" Visibility="Collapsed" Background="#B3000000">
            <Border Style="{StaticResource Card}" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Effect="{StaticResource PopupShadow}">
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DialogMessage" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                    <TextBox x:Name="DialogInput" Margin="0,16,0,0" Visibility="Collapsed" KeyDown="DialogInput_KeyDown"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button x:Name="DialogCancel" Style="{StaticResource SecondaryButton}" Content="Annuleren" Margin="0,0,8,0" Click="DialogCancel_Click" IsCancel="True"/>
                        <Button x:Name="DialogOk" Style="{StaticResource PrimaryButton}" Content="Doorgaan" Click="DialogOk_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

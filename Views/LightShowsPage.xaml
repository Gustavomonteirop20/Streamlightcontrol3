<UserControl x:Class="StreamLightControl2.Views.LightShowsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:StreamLightControl2.Controls"
             AllowDrop="True" Drop="Page_Drop" DragOver="Page_DragOver">
    <Grid Margin="24,22,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ============ LIJST MET SHOWS ============ -->
        <Border Style="{StaticResource Card}" Padding="14">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="4,2,0,12">
                    <TextBlock Text="Mijn lichtshows" Style="{StaticResource H3}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Tag="&#xE8B5;" Content="Importeren" MinHeight="30" Padding="10,0" Margin="0,0,6,0"
                                Click="Import_Click" ToolTip="Lichtshow-afbeelding (.png) of -bestand (.json) toevoegen. Je kunt de afbeelding ook op deze pagina slepen."/>
                        <Button Style="{StaticResource PrimaryButton}" Tag="&#xE710;" Content="Nieuw" MinHeight="30" Padding="10,0"
                                Click="New_Click" ToolTip="Nieuwe lichtshow maken"/>
                    </StackPanel>
                </Grid>
                <Button x:Name="FromSoundButton" DockPanel.Dock="Top" Style="{StaticResource SecondaryButton}" Tag="&#xE8D6;" Content="Show maken van een sound…" MinHeight="32" Margin="0,0,0,10"
                        Click="FromSound_Click" ToolTip="Kies een sound (mp3, wav, m4a, mp4): de app hoort de beat, kicks, drops en rustige stukken en maakt er een show van in de stijl van Nick z'n video. Je kunt een sound ook op deze pagina slepen."/>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" ui:Hint.Text="Zoeken…" Margin="0,0,0,10" TextChanged="Search_TextChanged"/>
                <ListBox x:Name="ShowsList" SelectionChanged="ShowsList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,54,0"/>
                                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" Padding="6,1" Background="{StaticResource InfoSoftBrush}"
                                            Visibility="{Binding IsPreset, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding PresetBadge}" FontSize="10" Foreground="{StaticResource Accent2Brush}"/>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <ItemsControl ItemsSource="{Binding Steps}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Sw" Width="12" Height="6" CornerRadius="3" Margin="0,0,3,0" Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Off"><Setter TargetName="Sw" Property="Background" Value="{StaticResource LineStrongBrush}"/></DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding TotalDurationMs, Converter={StaticResource MsToSec}}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ EDITOR ============ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Editor">
                <!-- Kop -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Naam" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FontWeight="SemiBold" MinHeight="40"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,0">
                                <Border x:Name="DirtyPill" Style="{StaticResource Pill}" Background="{StaticResource WarningSoftBrush}" Margin="0,0,10,0" Visibility="Collapsed">
                                    <TextBlock Text="Niet opgeslagen" FontSize="11" Foreground="{StaticResource WarningBrush}"/>
                                </Border>
                                <Button x:Name="RevertButton" Style="{StaticResource SecondaryButton}" Content="Annuleren" Margin="0,0,8,0" Click="Revert_Click" IsEnabled="False"
                                        ToolTip="Wijzigingen weggooien en terug naar de opgeslagen versie"/>
                                <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Tag="&#xE74E;" Content="Opslaan" Click="Save_Click" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Text="Herhalingen" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource NumberBox}" Text="{Binding Repeats, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Hoe vaak alle stappen achter elkaar worden afgespeeld (1–50)"/>
                                </StackPanel>
                                <StackPanel Margin="20,0,0,0">
                                    <TextBlock Text="Totale duur" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding TotalDurationMs, Converter={StaticResource MsToSec}}" Style="{StaticResource H2}" Margin="0,6,0,0"/>
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" Content="Precies afspelen" Margin="20,0,0,4" VerticalAlignment="Bottom"
                                          IsChecked="{Binding PlayExact}"
                                          ToolTip="Aan: de show speelt precies zoals hij gemaakt is (zoals de show van Nick), niet omgezet naar de rustige/festival-stijl. Shows gemaakt van een sound staan dit standaard aan."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource SmallButton}" Tag="&#xEDE1;" Content="Exporteren" Margin="0,0,6,0" Click="Export_Click"
                                        ToolTip="Opslaan als afbeelding (.png) met de show erin, om te delen of op een andere pc te importeren"/>
                                <Button Style="{StaticResource SmallButton}" Tag="&#xE8C8;" Content="Dupliceren" Margin="0,0,6,0" Click="Duplicate_Click"/>
                                <Button Style="{StaticResource SmallButton}" Tag="&#xE8AC;" Content="Hernoemen" Margin="0,0,6,0" Click="Rename_Click"/>
                                <Button x:Name="ResetPresetButton" Style="{StaticResource SmallButton}" Tag="&#xE777;" Content="Standaard herstellen" Margin="0,0,6,0" Click="ResetPreset_Click"
                                        ToolTip="Zet deze preset terug naar de fabrieksversie"/>
                                <Button Style="{StaticResource DangerButton}" Tag="&#xE74D;" Content="Verwijderen" MinHeight="30" Padding="10,0" FontSize="12" Click="Delete_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Preview + tijdlijn -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="230"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="PreviewSwatch" Height="128" CornerRadius="12" Background="#000000" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="#7B6CF6"/>
                                </Border.Effect>
                                <TextBlock x:Name="PreviewLabel" Text="Preview" Margin="14,12" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#CCFFFFFF"/>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Tag="&#xE768;" Content="Afspelen op lampen" MinHeight="42" Click="Play_Click"
                                        ToolTip="Stuurt deze lichtshow (ook niet-opgeslagen wijzigingen) echt naar je actieve Govee-lampen"/>
                                <Button Style="{StaticResource SecondaryButton}" Tag="&#xE71A;" Content="Stop" Margin="0,8,0,0" Click="Stop_Click"/>
                                <TextBlock x:Name="TargetsText" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,20,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="TIJDLIJN" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TimelineInfo" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButton}" Tag="&#xE71F;" Click="ZoomOut_Click" ToolTip="Uitzoomen"/>
                                <TextBlock x:Name="ZoomText" Style="{StaticResource Caption}" Width="44" TextAlignment="Center" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource IconButton}" Tag="&#xE8A3;" Click="ZoomIn_Click" ToolTip="Inzoomen (of Ctrl + scrollwiel op de tijdlijn)"/>
                                <Button Style="{StaticResource SmallButton}" Content="Passend" Margin="6,0,0,0" Click="ZoomFit_Click" ToolTip="Hele show in beeld"/>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer x:Name="TimelineScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="Timeline_PreviewMouseWheel" SizeChanged="TimelineScroller_SizeChanged">
                            <ui:TimelineView x:Name="Timeline" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Stappen -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Stappen" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SmallButton}" Tag="&#xE710;" Content="Kleur" Margin="0,0,6,0" Click="AddColor_Click" ToolTip="Kleurstap toevoegen"/>
                                <Button Style="{StaticResource SmallButton}" Tag="&#xE710;" Content="Uit" Click="AddOff_Click" ToolTip="Stap toevoegen waarin de lamp uit is"/>
                            </StackPanel>
                        </Grid>
                        <ListBox x:Name="StepsList" ItemsSource="{Binding Steps}" SelectionChanged="StepsList_SelectionChanged" MaxHeight="360">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <Border x:Name="Sw" Width="28" Height="28" CornerRadius="7" Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                    BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Tag="&#xE70E;" CommandParameter="{Binding}" Click="StepUp_Click" ToolTip="Omhoog"/>
                                            <Button Style="{StaticResource IconButton}" Tag="&#xE70D;" CommandParameter="{Binding}" Click="StepDown_Click" ToolTip="Omlaag"/>
                                            <Button Style="{StaticResource IconButton}" Tag="&#xE8C8;" CommandParameter="{Binding}" Click="StepCopy_Click" ToolTip="Dupliceren"/>
                                            <Button Style="{StaticResource IconButton}" Tag="&#xE74D;" CommandParameter="{Binding}" Click="StepDelete_Click" ToolTip="Verwijderen"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Off"><Setter TargetName="Sw" Property="Background" Value="{StaticResource InputBrush}"/></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ STAP-INSPECTOR ============ -->
        <Border Grid.Column="4" Style="{StaticResource Card}">
            <Grid>
                <TextBlock x:Name="NoStepText" Text="Selecteer een stap in de lijst of op de tijdlijn om hem te bewerken." Style="{StaticResource Muted}" VerticalAlignment="Top"/>
                <ScrollViewer x:Name="Inspector" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="StepTitle" Text="Stap" Style="{StaticResource H2}"/>
                        <Border Style="{StaticResource SegmentHost}" Margin="0,14,0,16">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="Kleur" GroupName="Kind"
                                             IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Color}"/>
                                <RadioButton Style="{StaticResource Segment}" Content="Lamp uit" GroupName="Kind"
                                             IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Off}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="ColorSection">
                            <TextBlock Text="Kleur" Style="{StaticResource FieldLabel}"/>
                            <ui:ColorPicker SelectedHex="{Binding ColorHex, Mode=TwoWay}"/>

                            <Grid Margin="0,18,0,0">
                                <TextBlock Text="Helderheid" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding Brightness, StringFormat={}{0}%}" HorizontalAlignment="Right" Style="{StaticResource Caption}"/>
                            </Grid>
                            <Slider Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Brightness}"/>

                            <Grid Margin="0,16,0,0">
                                <TextBlock Text="Aantal flitsen" Style="{StaticResource FieldLabel}" ToolTip="1 = de kleur blijft staan. 2 of meer = knipperen binnen de duur van de stap."/>
                                <TextBox Style="{StaticResource NumberBox}" Width="64" MinHeight="28" HorizontalAlignment="Right" Text="{Binding Flashes, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Flashes}" Margin="0,6,0,0"/>

                            <Grid Margin="0,16,0,0">
                                <TextBlock Text="Overgang (ms)" Style="{StaticResource FieldLabel}" ToolTip="Vloeiend overvloeien vanaf de vorige kleur. Werkt bij 1 flits."/>
                                <TextBox Style="{StaticResource NumberBox}" Width="64" MinHeight="28" HorizontalAlignment="Right" Text="{Binding TransitionMs, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="3000" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding TransitionMs}" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <TextBlock Text="Duur van de stap (ms)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource NumberBox}" Width="64" MinHeight="28" HorizontalAlignment="Right" Text="{Binding DurationMs, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Slider Minimum="100" Maximum="5000" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding DurationMs}" Margin="0,6,0,0"/>

                        <Button Style="{StaticResource SecondaryButton}" Tag="&#xEA80;" Content="Test deze stap op lampen" Margin="0,22,0,0" Click="TestStep_Click"
                                HorizontalAlignment="Stretch" ToolTip="Zet de kleur en helderheid van deze stap direct op je lampen"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

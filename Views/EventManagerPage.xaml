<UserControl x:Class="StreamLightControl2.Views.EventManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StreamLightControl2"
             xmlns:ui="clr-namespace:StreamLightControl2.Controls">
    <Grid Margin="24,22,24,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <!-- Simuleren -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Event simuleren" Style="{StaticResource H2}"/>
                    <TextBlock Text="Stuurt een nep-event door de echte verwerking: regels → wachtrij → lampen. Zo zie je precies wat er live zou gebeuren."
                               Style="{StaticResource Caption}" Margin="0,4,0,14"/>
                    <WrapPanel>
                        <Button Style="{StaticResource SmallButton}" Tag="&#xE8FA;" Content="Follow" Margin="0,0,6,6" CommandParameter="follow" Click="Simulate_Click"/>
                        <Button Style="{StaticResource SmallButton}" Tag="&#xEB51;" Content="Like" Margin="0,0,6,6" CommandParameter="like" Click="Simulate_Click"/>
                        <Button Style="{StaticResource SmallButton}" Tag="&#xE72D;" Content="Share" Margin="0,0,6,6" CommandParameter="share" Click="Simulate_Click"/>
                        <Button Style="{StaticResource SmallButton}" Tag="&#xE8BD;" Content="Comment" Margin="0,0,6,6" CommandParameter="comment" Click="Simulate_Click"/>
                        <Button Style="{StaticResource SmallButton}" Tag="&#xE77B;" Content="Kijker komt binnen" Margin="0,0,16,6" CommandParameter="member" Click="Simulate_Click"/>
                        <Button Style="{StaticResource SmallButton}" Tag="&#xE8C7;" Content="DonateWave-tip €5" Margin="0,0,16,6" CommandParameter="tip" Click="Simulate_Click"
                                ToolTip="Doet alsof er een tip van € 5 binnenkomt via DonateWave"/>
                        <Button Style="{StaticResource SmallButton}" Tag="&#xE789;" Content="Shout-out" Margin="0,0,16,6" CommandParameter="shoutout" Click="Simulate_Click"
                                ToolTip="Doet alsof er een DonateWave shout-out van € 5 binnenkomt"/>
                        <Button Style="{StaticResource SmallButton}" Tag="&#xE77B;" Content="Thomas komt binnen" Margin="0,0,16,6" CommandParameter="member:thomas" Click="Simulate_Click"
                                ToolTip="Doet alsof Thomas de LIVE binnenkomt"/>
                        <Button Style="{StaticResource SmallButton}" Tag="&#xE77B;" Content="Diego komt binnen" Margin="0,0,16,6" CommandParameter="member:diego" Click="Simulate_Click"
                                ToolTip="Doet alsof Diego de LIVE binnenkomt"/>
                        <Button Style="{StaticResource SmallButton}" Tag="&#xE77B;" Content="Martin komt binnen" Margin="0,0,16,6" CommandParameter="member:martin" Click="Simulate_Click"
                                ToolTip="Doet alsof Martin de LIVE binnenkomt (C4-sound)"/>
                        <TextBox x:Name="SimGiftName" ui:Hint.Text="Giftnaam (bijv. Rose)" Width="170" MinHeight="30" Margin="0,0,6,6"/>
                        <TextBox x:Name="SimCoins" ui:Hint.Text="Coins" Text="100" Width="80" MinHeight="30" Margin="0,0,6,6"/>
                        <Button Style="{StaticResource SmallButton}" Tag="&#xE734;" Content="Gift" Margin="0,0,6,6" CommandParameter="gift" Click="Simulate_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="SimResult" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Tabel -->
            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="20,18,20,14">
                        <StackPanel Orientation="Horizontal" x:Name="Filters">
                            <RadioButton Style="{StaticResource Chip}" Content="Alles" GroupName="EvFilter" Tag="" IsChecked="True" Checked="Filter_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Follow" GroupName="EvFilter" Tag="follow" Checked="Filter_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Gift" GroupName="EvFilter" Tag="gift" Checked="Filter_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Like" GroupName="EvFilter" Tag="like" Checked="Filter_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Share" GroupName="EvFilter" Tag="share" Checked="Filter_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Comment" GroupName="EvFilter" Tag="comment" Checked="Filter_Checked"/>
                            <RadioButton Style="{StaticResource Chip}" Content="Overig" GroupName="EvFilter" Tag="other" Checked="Filter_Checked"/>
                        </StackPanel>
                        <Button Style="{StaticResource PrimaryButton}" Tag="&#xE710;" Content="Koppeling toevoegen" HorizontalAlignment="Right" Click="Add_Click"/>
                    </Grid>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1" Background="{StaticResource InputBrush}" Padding="24,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="112"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ACTIEF" Style="{StaticResource Overline}"/>
                            <TextBlock Grid.Column="1" Text="KOPPELING" Style="{StaticResource Overline}"/>
                            <TextBlock Grid.Column="2" Text="EVENTTYPE" Style="{StaticResource Overline}"/>
                            <TextBlock Grid.Column="3" Text="LICHTSHOW" Style="{StaticResource Overline}" Margin="10,0,0,0"/>
                            <TextBlock Grid.Column="4" Text="PRIORITEIT" Style="{StaticResource Overline}" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                    <Grid>
                        <TextBlock Text="Geen koppelingen in deze categorie. Klik op ‘Koppeling toevoegen’." Style="{StaticResource Caption}" Margin="24,20"
                                   x:Name="EmptyText" Visibility="Collapsed"/>
                        <ListBox x:Name="TriggerList" Padding="12,6" SelectionChanged="TriggerList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" ToolTip="Koppeling aan/uit"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ConditionSummary}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" ItemsSource="{x:Static local:Options.EventTypeList}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding EventType}"/>
                                        <ComboBox Grid.Column="3" Margin="10,0,0,0" ItemsSource="{Binding DataContext.Settings.Shows, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ShowId}"/>
                                        <ComboBox Grid.Column="4" Margin="10,0,0,0" ItemsSource="{x:Static local:Options.PriorityList}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Priority}"/>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0">
                                            <Button Style="{StaticResource IconButton}" Tag="&#xE768;" CommandParameter="{Binding}" Click="Test_Click" ToolTip="Test: speel deze lichtshow nu af op je lampen"/>
                                            <Button Style="{StaticResource IconButton}" Tag="&#xE70F;" CommandParameter="{Binding}" Click="Edit_Click" ToolTip="Details bewerken"/>
                                            <Button Style="{StaticResource IconButton}" Tag="&#xE74D;" CommandParameter="{Binding}" Click="Delete_Click" ToolTip="Verwijderen"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- Details -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <StackPanel x:Name="NoSelection">
                    <TextBlock Text="Details" Style="{StaticResource H2}"/>
                    <TextBlock Text="Kies een koppeling om alle opties te zien: cooldown, maximaal in de wachtrij, onderbreken en voorwaarden zoals giftnaam of coins."
                               Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                    <Border Style="{StaticResource Panel}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Hoe werkt het?" Style="{StaticResource H3}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Text="Elk event speelt maximaal één lichtshow. Passen er meerdere koppelingen, dan wint: 1) een specifieke giftnaam, 2) de hoogste prioriteit, 3) het smalste coin-bereik."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <ScrollViewer x:Name="Details" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Details" Style="{StaticResource H2}" Margin="0,0,0,16"/>
                        <TextBlock Text="Naam" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>
                        <TextBlock Text="Eventtype" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DetailType" ItemsSource="{x:Static local:Options.EventTypeList}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding EventType}" Margin="0,0,0,14" SelectionChanged="DetailType_SelectionChanged"/>
                        <TextBlock Text="Lichtshow" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DetailShow" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding ShowId}" Margin="0,0,0,14"/>
                        <TextBlock Text="Prioriteit" Style="{StaticResource FieldLabel}" ToolTip="Hogere prioriteit gaat eerder in de wachtrij en wint bij overlappende regels."/>
                        <ComboBox ItemsSource="{x:Static local:Options.PriorityList}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Priority}" Margin="0,0,0,18"/>
                        <TextBlock Text="Show pas starten na (seconden)" Style="{StaticResource FieldLabel}"
                                   ToolTip="Bijv. de duur van de animatie van een DonateWave shout-out: de extra sound (en dus de show) begint pas daarna. 0 = meteen."/>
                        <TextBox Text="{Binding StartDelaySeconds, UpdateSourceTrigger=LostFocus}" ui:Hint.Text="0" Margin="0,0,0,14"/>
                        <TextBlock Text="Sound bij dit event duurt (seconden)" Style="{StaticResource FieldLabel}"
                                   ToolTip="Bijv. de follow-sound in BetterTok. Volgen er 2 mensen, dan begint het licht voor de tweede pas als de sound van de eerste helemaal klaar is. 0 = alleen de lichtshow."/>
                        <TextBox Text="{Binding SoundDurationSeconds, UpdateSourceTrigger=LostFocus}" ui:Hint.Text="0" Margin="0,0,0,18"/>

                        <StackPanel x:Name="GiftSection">
                            <TextBlock Text="VOORWAARDEN – GIFT" Style="{StaticResource Overline}" Margin="0,0,0,10"/>
                            <TextBlock Text="Giftnamen (optioneel, komma-gescheiden)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding GiftNames, UpdateSourceTrigger=LostFocus}" ui:Hint.Text="Leeg = elke gift, bijv. Rose, Heart Me" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Vanaf (coins)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding MinCoins, TargetNullValue=''}" ui:Hint.Text="geen"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tot en met (coins)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding MaxCoins, TargetNullValue=''}" ui:Hint.Text="geen grens"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="TipSection">
                            <TextBlock Text="VOORWAARDEN – DONATEWAVE-TIP" Style="{StaticResource Overline}" Margin="0,0,0,10"/>
                            <TextBlock Text="Soort tip" Style="{StaticResource FieldLabel}" ToolTip="Een regel voor shout-outs of Lucky Wheel gaat voor de gewone bedrag-regels."/>
                            <ComboBox ItemsSource="{x:Static local:Options.TipKindList}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TipKind}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Vanaf (€)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding MinEuro, UpdateSourceTrigger=LostFocus}" ui:Hint.Text="geen" ToolTip="Bijv. 10 of 9,99"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tot en met (€)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding MaxEuro, UpdateSourceTrigger=LostFocus}" ui:Hint.Text="geen grens"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="CommentSection">
                            <TextBlock Text="VOORWAARDEN – COMMENT" Style="{StaticResource Overline}" Margin="0,0,0,10"/>
                            <TextBlock Text="Alleen als de comment dit bevat" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding MatchText, UpdateSourceTrigger=LostFocus}" ui:Hint.Text="Leeg = elke comment, bijv. !rainbow" Margin="0,0,0,18"/>
                        </StackPanel>
                        <StackPanel x:Name="MemberSection">
                            <TextBlock Text="VOORWAARDEN – BINNENKOMST" Style="{StaticResource Overline}" Margin="0,0,0,10"/>
                            <TextBlock Text="Alleen voor deze kijker(s)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding MatchText, UpdateSourceTrigger=LostFocus}" ui:Hint.Text="Leeg = iedereen, bijv. thomas" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,18" TextWrapping="Wrap"
                                       Text="De TikTok-naam (zonder @) of de weergavenaam, precies zoals op TikTok. Meerdere kijkers: scheiden met een komma."/>
                        </StackPanel>
                        <StackPanel x:Name="LikeSection">
                            <TextBlock Text="VOORWAARDEN – LIKES" Style="{StaticResource Overline}" Margin="0,0,0,10"/>
                            <TextBlock Text="Afspelen per zoveel likes (0 = bij elk like-bericht)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource NumberBox}" Text="{Binding LikeThreshold}" Margin="0,0,0,18"/>
                        </StackPanel>

                        <TextBlock Text="GEDRAG" Style="{StaticResource Overline}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Cooldown (seconden)" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" ToolTip="Na afspelen even wachten voordat deze koppeling opnieuw mag."/>
                            <TextBox Style="{StaticResource NumberBox}" HorizontalAlignment="Right" Text="{Binding CooldownSeconds}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Max. tegelijk in wachtrij" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" ToolTip="0 = onbeperkt. Voorkomt een wachtrij vol met dezelfde effecten."/>
                            <TextBox Style="{StaticResource NumberBox}" HorizontalAlignment="Right" Text="{Binding MaxInQueue}"/>
                        </Grid>
                        <CheckBox Style="{StaticResource Switch}" Content="Onderbreekt een lopende show met lagere prioriteit" IsChecked="{Binding InterruptCurrent}" Margin="0,4,0,12"/>
                        <CheckBox Style="{StaticResource Switch}" Content="Koppeling actief" IsChecked="{Binding Enabled}" Margin="0,0,0,20"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Tag="&#xE768;" Content="Test" Margin="0,0,8,0" Click="DetailTest_Click"/>
                            <Button Style="{StaticResource DangerButton}" Tag="&#xE74D;" Content="Verwijderen" Click="DetailDelete_Click"/>
                        </StackPanel>
                        <TextBlock Text="Wijzigingen worden automatisch opgeslagen." Style="{StaticResource Caption}" Margin="0,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

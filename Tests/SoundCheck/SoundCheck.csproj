<Project Sdk="Microsoft.NET.Sdk">
  <!-- Alleen op Windows (GitHub-bouwcontrole): leest mp3/m4a zoals de app en maakt er een show van -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\UI\SoundDecoder.cs" Link="SoundDecoder.cs" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
